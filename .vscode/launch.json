{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Assessment: Interactive OAuth (MVP)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/.vscode/Invoke-Assessment.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true,
      "args": []
    },
    {
      "name": "PowerShell Launch Script",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/src/helper-functions/Publish-Main.ps1",
      "cwd": "${cwd}",
      "args": ["-RootDirectory", "${workspaceFolder}"]
    },
    {
      "name": "Pester: Unit Tests",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tests/Run-Tests.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true,
      "args": ["-TestType", "Unit"]
    },
    {
      "name": "Pester: Integration Tests",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tests/Run-Tests.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true,
      "args": ["-TestType", "Integration"]
    },
    {
      "name": "Pester: Authentication Tests",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tests/Run-Tests.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true,
      "args": ["-TestType", "Authentication"]
    }
  ]
}
